# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store

# Environment files - never commit real env values.
# Ignores .env and every .env.<name> (.env.local, .env.production, ...),
# but a committed .env.example template is still allowed.
.env
.env.*
!.env.example

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local IDE/Copilot migration state - not covered by .idea/.gitignore's
# narrower /workspace.xml-only rule, and not meant to be shared.
.idea/copilot.data.migration.agent.xml
.idea/copilot.data.migration.edit.xml

# Internal AI audit reports - local working notes, not part of the repo
FRONTEND_DEEP_AUDIT.md
FRONTEND_FIGMA_DESIGN_SYSTEM_AUDIT.md

# Local Claude Code settings - may hold machine-local permission allowlists/credentials,
# never meant to be shared or committed.
.claude/
